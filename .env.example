# Application Demo Configuration (Optional)
NEXT_PUBLIC_DEMO_USER_NUMBER="01700000000"
NEXT_PUBLIC_DEMO_USER_PASS="member1"

# Database Configuration (Turso / libSQL or local SQLite)
# For remote Turso: libsql://<database-name>-<org>.turso.io
# For local SQLite: file:prisma/dev.db
DATABASE_URL="file:prisma/dev.db"

# Turso Database Auth Token (Required when using remote Turso database)
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# Authentication Session Secret (JWT signing secret)
AUTH_SECRET="your_secure_random_jwt_secret_here"
